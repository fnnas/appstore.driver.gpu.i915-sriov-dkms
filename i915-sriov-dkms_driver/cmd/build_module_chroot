#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
i18n_script="${SCRIPT_DIR}/i18n.sh"
source "$i18n_script" || exit 1

kernel_ver=${1:-}
output_dir=${2:-}
if [[ -z "$kernel_ver" ]]; then
    i915_message missing_kernel_arg >&2
    exit 1
fi
if [[ -z "$output_dir" ]]; then
    i915_message missing_output_arg >&2
    exit 1
fi
if [[ -z "${TRIM_APPDEST:-}" ]]; then
    i915_message missing_appdest >&2
    exit 1
fi
source_dir="${TRIM_APPDEST}/app/i915-sriov-dkms-source"
work_dir="${TRIM_PKGVAR:-/tmp}/i915-sriov-dkms-chroot.$$"
root_dir="${work_dir}/root"

cleanup() {
    local status=$?

    trap - EXIT
    set +e
    umount -l "${root_dir}/proc" 2>/dev/null
    umount -l "${root_dir}/dev" 2>/dev/null
    umount -l "$root_dir" 2>/dev/null
    rm -rf -- "$work_dir"
    exit "$status"
}
trap cleanup EXIT

mkdir -p "${work_dir}/upper" "${work_dir}/work" "$root_dir"
mount -t overlay overlay \
    -o "lowerdir=/,upperdir=${work_dir}/upper,workdir=${work_dir}/work" \
    "$root_dir"
mount --bind /dev "${root_dir}/dev"
mount -t proc proc "${root_dir}/proc"

rm -f "${root_dir}/etc/resolv.conf"
cp -L /etc/resolv.conf "${root_dir}/etc/resolv.conf"

i915_message building_in_chroot "$kernel_ver"
chroot "$root_dir" /bin/bash -s -- "$source_dir" "$kernel_ver" "$i18n_script" <<'CHROOT_BUILD'
set -euo pipefail
source_dir=$1
kernel_ver=$2
source "$3" || exit 1

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends \
    bc \
    bison \
    build-essential \
    dkms \
    flex \
    libelf-dev \
    libssl-dev

kernel_build_dir="/lib/modules/${kernel_ver}/build"
kernel_config="/boot/config-${kernel_ver}"
if [[ -d "$kernel_build_dir" && ! -f "${kernel_build_dir}/.config" ]]; then
    if [[ -f "$kernel_config" ]]; then
        cp -f "$kernel_config" "${kernel_build_dir}/.config"
        i915_message kernel_config_staged "$kernel_config"
    else
        i915_message warning "$(i915_message kernel_config_missing "$kernel_build_dir" "$kernel_config")" >&2
    fi
fi

package_name=$(sed -n 's/^PACKAGE_NAME="\([^"]*\)"/\1/p' "$source_dir/dkms.conf" | head -n 1)
package_version=$(sed -n 's/^PACKAGE_VERSION="\([^"]*\)"/\1/p' "$source_dir/dkms.conf" | head -n 1)

if [[ -z "$package_name" || -z "$package_version" ]]; then
    i915_message dkms_metadata_unreadable "$source_dir" >&2
    exit 1
fi

run_dkms_install_with_live_log() {
    local make_log="/var/lib/dkms/${package_name}/${package_version}/build/make.log"
    local dkms_pid
    local dkms_status
    local tail_pid

    rm -f "$make_log"
    dkms install "$package_name/$package_version" -k "$kernel_ver" --verbose --force &
    dkms_pid=$!

    i915_message stream_dkms_log "$make_log"
    tail -n +1 -F --pid="$dkms_pid" "$make_log" 2>/dev/null &
    tail_pid=$!

    if wait "$dkms_pid"; then
        dkms_status=0
    else
        dkms_status=$?
    fi

    wait "$tail_pid" || true

    return "$dkms_status"
}

if dkms status -m "$package_name" -v "$package_version" | grep -q .; then
    i915_message replace_dkms_registration "$package_name" "$package_version"
    dkms remove "$package_name/$package_version" --all
fi

dkms add "$source_dir"
run_dkms_install_with_live_log
CHROOT_BUILD

module_dir="${root_dir}/lib/modules/${kernel_ver}/updates/dkms"
mapfile -t module_names < <(sed -n 's/^BUILT_MODULE_NAME\[[0-9][0-9]*\]="\([^"]*\)"/\1/p' "${source_dir}/dkms.conf")
module_files=()

find_installed_module() {
    local module_name=$1
    local compression_suffix
    local module_file

    for compression_suffix in "" .xz .zst .gz; do
        module_file="${module_dir}/${module_name}.ko${compression_suffix}"
        if [[ -f "$module_file" ]]; then
            printf '%s\n' "$module_file"
            return 0
        fi
    done
    return 1
}

if [[ ${#module_names[@]} -eq 0 ]]; then
    i915_message module_names_missing "$source_dir" >&2
    exit 1
fi

for module_name in "${module_names[@]}"; do
    if ! module_file=$(find_installed_module "$module_name"); then
        i915_message built_module_missing "$module_name" "$module_dir" >&2
        exit 1
    fi
    module_files+=("$module_file")
done

mkdir -p "$output_dir"
cp -f -- "${module_files[@]}" "$output_dir/"
i915_message modules_stored "$output_dir"
