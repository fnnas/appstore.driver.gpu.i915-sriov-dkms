#!/bin/bash
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
PACKAGE_BASE=${TRIM_APPDEST:-}
MODULE_ROOT=${MODULE_ROOT:-/lib/modules}
CHROOT_BUILD_SCRIPT=${CHROOT_BUILD_SCRIPT:-${SCRIPT_DIR}/build_module_chroot}
CHROOT_BUILD_LOCK=${CHROOT_BUILD_LOCK:-/tmp/i915-sriov-dkms-chroot-build.lock}

print_pci() {
	gpu_addrs=$(lspci -Dn | awk '$2 ~ /^03/ {print $1}')
	if [[ -z "$gpu_addrs" ]]; then
		echo "not found gpu"
	fi
	for addr in $gpu_addrs; do
		echo
		echo "========== GPU @ $addr =========="
		lspci -s "$addr" -vvnnk
	done
}

fail() {
	local message="$*"

	echo "error: ${message}" >&2
	if [[ -n "${TRIM_TEMP_LOGFILE:-}" ]]; then
		printf '%s\t%s\n' "$(date +'%Y/%m/%d %H:%M:%S')" "${message}" >> "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
	fi
	exit 1
}

reset_user_visible_log() {
	if [[ -n "${TRIM_TEMP_LOGFILE:-}" ]]; then
		: > "${TRIM_TEMP_LOGFILE}"
	fi
}

run_with_user_visible_log() {
	local command_status

	if [[ -z "${TRIM_TEMP_LOGFILE:-}" ]]; then
		"$@"
		return $?
	fi

	"$@" 2>&1 | tee -a "${TRIM_TEMP_LOGFILE}"
	command_status=${PIPESTATUS[0]}
	return "${command_status}"
}

require_kernel_build_num() {
	if [[ ! "${nowKernelBuildNum}" =~ ^[0-9]+$ ]]; then
		fail "Unable to detect the current kernel build number: $(uname -v). Please include this log when reporting the issue."
	fi
}

module_payload_exists() {
	local src_dir="$1"
	local compression_suffix

	[[ -d "${src_dir}" ]] || return 1
	for compression_suffix in "" .xz .zst .gz; do
		[[ -f "${src_dir}/i915.ko${compression_suffix}" ]] && return 0
	done
	return 1
}

copy_kernel_module() {
	local src_dir="$1"
	local dst_dir="$2"

	if [[ ! -d "${src_dir}" ]]; then
		fail "Missing driver module package for the current kernel: ${src_dir}. Please verify that the installation package is complete, or download it again and reinstall."
	fi

	if ! module_payload_exists "${src_dir}"; then
		fail "No prebuilt kernel modules were found for the current kernel in: ${src_dir}."
	fi

	mkdir -p "${dst_dir}" || fail "Failed to create the kernel module directory: ${dst_dir}."
	cp -rf "${src_dir}/." "${dst_dir}/" || fail "Failed to copy kernel modules: ${src_dir} -> ${dst_dir}."
}

local_build_allowed() {
	[[ "${wizard_module_install_mode:-prebuilt_only}" == "allow_local_build" ]]
}

acquire_local_build_lock() {
	local kernel_ver="$1"

	if [[ -e "${CHROOT_BUILD_LOCK}" || -L "${CHROOT_BUILD_LOCK}" ]]; then
		fail "A local chroot build is already running, or a previous build failed or was interrupted. Automatic retry is disabled. Reboot the system or remove ${CHROOT_BUILD_LOCK} manually before trying again."
	fi

	if ! (
		set -o noclobber
		printf 'kernel=%s\nstarted_at=%s\npid=%s\n' \
			"${kernel_ver}" "$(date +'%Y/%m/%d %H:%M:%S')" "$$" > "${CHROOT_BUILD_LOCK}"
	) 2>/dev/null; then
		fail "Unable to create the local chroot build lock: ${CHROOT_BUILD_LOCK}. Another build may already be running."
	fi
}

release_local_build_lock() {
	if ! rm -f -- "${CHROOT_BUILD_LOCK}"; then
		echo "warning: Failed to remove the local chroot build lock: ${CHROOT_BUILD_LOCK}" >&2
	fi
}

select_kernel_module_payload() {
	local kernel_ver="$1"

	case "${kernel_ver}" in
	6.12.5-trim)
		require_kernel_build_num
		if [[ ${nowKernelBuildNum} -le 9 ]]; then
			fail "The current kernel ${nowKernelVer} build #${nowKernelBuildNum} is not supported. Please upgrade to 6.12.5-trim build #10 or newer before installing."
		fi
		MODULE_PAYLOAD_DIR="i915-sriov-dkms_6.12.5-trim_10"
		;;
	6.12.18-trim)
		MODULE_PAYLOAD_DIR="i915-sriov-dkms_6.12.18-trim_3"
		;;
	6.18.6-trim)
		MODULE_PAYLOAD_DIR="i915-sriov-dkms_6.18.6-trim-297-amd64"
		;;
	6.18.18-trim)
		require_kernel_build_num
		if [[ ${nowKernelBuildNum} -lt 570 ]]; then
			MODULE_PAYLOAD_DIR="i915-sriov-dkms_6.18.18-trim-427-amd64"
		elif [[ ${nowKernelBuildNum} -lt 587 ]]; then
			MODULE_PAYLOAD_DIR="i915-sriov-dkms_6.18.18-trim-570-amd64"
		elif [[ ${nowKernelBuildNum} -lt 717 ]]; then
			MODULE_PAYLOAD_DIR="i915-sriov-dkms_6.18.18-trim-587-amd64"
		else
			MODULE_PAYLOAD_DIR="i915-sriov-dkms_6.18.18-trim-717-amd64"
		fi
		;;
	6.18.18.c788-trim)
		MODULE_PAYLOAD_DIR="i915-sriov-dkms_6.18.18.c788-trim-amd64"
		;;
	6.18.18.c877-trim)
		MODULE_PAYLOAD_DIR="i915-sriov-dkms_6.18.18.c877-trim-amd64"
		;;
	6.18.18.c938-trim)
		MODULE_PAYLOAD_DIR="i915-sriov-dkms_6.18.18.c938-trim-amd64"
		;;
	*)
		MODULE_PAYLOAD_DIR="i915-sriov-dkms_${kernel_ver}"
		;;
	esac
}

build_kernel_module_payload() {
	local kernel_ver="$1"
	local payload_dir="$2"
	local source_dir="${PACKAGE_BASE}/app/i915-sriov-dkms-source"
	local output_dir="${PACKAGE_BASE}/app/${payload_dir}"

	if [[ ! -f "${source_dir}/dkms.conf" ]]; then
		fail "The packaged i915-sriov-dkms source code is missing; the chroot fallback build cannot start."
	fi

	if [[ ! -f "${CHROOT_BUILD_SCRIPT}" ]]; then
		fail "The chroot build script is missing: ${CHROOT_BUILD_SCRIPT}."
	fi

	acquire_local_build_lock "${kernel_ver}"
	echo "No prebuilt i915-sriov-dkms modules were found for ${kernel_ver}; starting the requested chroot fallback build."
	if ! run_with_user_visible_log bash "${CHROOT_BUILD_SCRIPT}" "${kernel_ver}" "${output_dir}"; then
		fail "Failed to build i915-sriov-dkms modules for kernel ${kernel_ver} in chroot."
	fi

	if ! module_payload_exists "${output_dir}"; then
		fail "The chroot build completed without producing kernel modules for ${kernel_ver}."
	fi

	release_local_build_lock
}

if [[ "$1" != "status" ]]; then
	echo -e "$(date +'%Y/%m/%d %H:%M:%S')\t" $0 $*
fi

nowKernelVer=$(uname -r)
nowKernelBuildNum=$(uname -v | grep -oP '(?<=#)\d+')

case $1 in
start)
	reset_user_visible_log
	echo "$(uname -a)"
	echo "kernel_inf ${nowKernelVer} ${nowKernelBuildNum}"

	if [[ -z "${PACKAGE_BASE}" ]]; then
		fail "Missing environment variable TRIM_APPDEST. Unable to locate the application installation directory."
	fi

	select_kernel_module_payload "${nowKernelVer}"
	payload_dir="${MODULE_PAYLOAD_DIR}"
	payload_path="${PACKAGE_BASE}/app/${payload_dir}"
	kernel_named_payload_dir="i915-sriov-dkms_${nowKernelVer}"
	kernel_named_payload_path="${PACKAGE_BASE}/app/${kernel_named_payload_dir}"

	if ! module_payload_exists "${payload_path}" && module_payload_exists "${kernel_named_payload_path}"; then
		echo "Using the existing kernel-named module payload: ${kernel_named_payload_path}"
		payload_dir="${kernel_named_payload_dir}"
		payload_path="${kernel_named_payload_path}"
	fi

	if ! module_payload_exists "${payload_path}" && local_build_allowed; then
		payload_dir="${kernel_named_payload_dir}"
		payload_path="${kernel_named_payload_path}"
		build_kernel_module_payload "${nowKernelVer}" "${payload_dir}"
	fi

	copy_kernel_module "${payload_path}" "${MODULE_ROOT}/${nowKernelVer}/updates/dkms/i915-sriov-dkms"

	if ! compgen -G "${PACKAGE_BASE}/app/firmware/*" >/dev/null; then
		fail "Missing i915 firmware files: ${PACKAGE_BASE}/app/firmware. Please verify that the installation package is complete, or download it again and reinstall."
	fi
	mkdir -p /usr/lib/firmware/i915 || fail "Failed to create the firmware directory: /usr/lib/firmware/i915."
	cp -nv "${PACKAGE_BASE}"/app/firmware/* /usr/lib/firmware/i915/ || fail "Failed to copy i915 firmware files."
	echo "firmware list"
	ls -al /usr/lib/firmware/i915/
	md5sum /usr/lib/firmware/i915/*

	echo "depmod："
	depmod || fail "depmod failed. Kernel module dependencies were not updated."
	if grub-mkconfig -o /dev/null;then
		echo "update-initramfs -u"
		update-initramfs -u || fail "update-initramfs failed. The initramfs was not updated."
	else
		fail "grub configuration validation failed. update-initramfs was not run. Please check the grub configuration and try again."
	fi

	for mod in i915 kvmgt; do
	  echo "modprobe -D $mod"
	  modprobe -D "$mod"
	done

	echo "try remove driver"
	if modprobe -r -v i915;then
	  echo "try load driver"
		modprobe -v i915
		systemctl restart mediasrv.service resmon_service.service || echo "systemctl restart failed"
	fi

	echo "find i915 file"
	find /lib/modules/ -name "*915*"
	echo "/proc/cmdline"
	cat /proc/cmdline

	echo "dmesg $(uptime)"
	dmesg | grep i915 | grep -v '0x550b failed' | grep -v 'state (-EPROTO)'
	print_pci
	;;
stop) ;;

status)
	if [ ! -d "${MODULE_ROOT}/$(uname -r)/updates/dkms/i915-sriov-dkms" ]; then
		echo -e "$(date +'%Y/%m/%d %H:%M:%S')\t" $0 $*
		echo "dmesg $(uptime)"
		dmesg | grep i915 | grep -v '0x550b failed' | grep -v 'state (-EPROTO)'
		exit 3
	fi
	;;
*)
	fail "Unknown command: $1"
	;;
esac
