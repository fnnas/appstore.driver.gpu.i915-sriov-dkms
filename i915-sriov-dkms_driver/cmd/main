#!/bin/bash
print_pci() {
	gpu_addrs=$(lspci -Dn | awk '$2 ~ /^03/ {print $1}')
	if [[ -z "$gpu_addrs" ]]; then
		echo "not found gpu"
	fi
	for addr in $gpu_addrs; do
		echo
		echo "========== GPU @ $addr =========="
		lspci -s "$addr" -vvnnk
	done
}

copy_kernel_module() {
	local src_dir="$1"
	local dst_dir="$2"

	if [[ ! -d "${src_dir}" ]]; then
		echo "error missing kernel module package: ${src_dir}" >&2
		exit 1
	fi

	mkdir -p "${dst_dir}"
	cp -rf "${src_dir}"/* "${dst_dir}/"
}

if [[ "$1" != "status" ]]; then
	echo -e "$(date +'%Y/%m/%d %H:%M:%S')\t" $0 $*
fi

PACKAGE_BASE=${TRIM_APPDEST}

supportKernelList=("6.12.5-trim" "6.12.18-trim" "6.18.6-trim" "6.18.18-trim" "6.18.18.c788-trim" "6.18.18.c877-trim")

nowKernelVer=$(uname -r)
nowKernelBuildNum=$(uname -v | grep -oP '(?<=#)\d+')

case $1 in
start)
	echo "$(uname -a)"
	echo "kernel_inf ${nowKernelVer} ${nowKernelBuildNum}"

	if [[ " ${supportKernelList[@]} " =~ " ${nowKernelVer} " ]]; then
		echo "${nowKernelVer} in supportKernelList"
	else
		echo "${nowKernelVer} not in supportKernelList"
		exit 1
	fi


	case "$nowKernelVer" in

	6.12.5-trim)
		if [[ ${nowKernelBuildNum} -le 9 ]]; then
			echo "debug 6.12.5-trim le9 not support"
			exit 1
		fi
		if [[ ${nowKernelBuildNum} -ge 10 ]]; then
			echo "debug 6.12.5-trim ge10"
			copy_kernel_module "${PACKAGE_BASE}/app/i915-sriov-dkms_6.12.5-trim_10" "/lib/modules/6.12.5-trim/updates/dkms/i915-sriov-dkms"
		fi
		;;

	6.12.18-trim)
		echo "debug 6.12.18-trim"
		copy_kernel_module "${PACKAGE_BASE}/app/i915-sriov-dkms_6.12.18-trim_3" "/lib/modules/6.12.18-trim/updates/dkms/i915-sriov-dkms"
		;;

	6.18.6-trim)
		echo "debug 6.18.6-trim"
		copy_kernel_module "${PACKAGE_BASE}/app/i915-sriov-dkms_6.18.6-trim-297-amd64" "/lib/modules/6.18.6-trim/updates/dkms/i915-sriov-dkms"
		;;

	6.18.18-trim)
		echo "debug 6.18.18-trim"
		if [[ ${nowKernelBuildNum} -lt 570 ]]; then
			copy_kernel_module "${PACKAGE_BASE}/app/i915-sriov-dkms_6.18.18-trim-427-amd64" "/lib/modules/6.18.18-trim/updates/dkms/i915-sriov-dkms"
		elif [[ ${nowKernelBuildNum} -lt 587 ]]; then
			copy_kernel_module "${PACKAGE_BASE}/app/i915-sriov-dkms_6.18.18-trim-570-amd64" "/lib/modules/6.18.18-trim/updates/dkms/i915-sriov-dkms"
		elif [[ ${nowKernelBuildNum} -lt 717 ]]; then
			copy_kernel_module "${PACKAGE_BASE}/app/i915-sriov-dkms_6.18.18-trim-587-amd64" "/lib/modules/6.18.18-trim/updates/dkms/i915-sriov-dkms"
		else
			copy_kernel_module "${PACKAGE_BASE}/app/i915-sriov-dkms_6.18.18-trim-717-amd64" "/lib/modules/6.18.18-trim/updates/dkms/i915-sriov-dkms"
		fi
		;;

	6.18.18.c788-trim)
		echo "debug 6.18.18.c788-trim"
		copy_kernel_module "${PACKAGE_BASE}/app/i915-sriov-dkms_6.18.18.c788-trim-amd64" "/lib/modules/6.18.18.c788-trim/updates/dkms/i915-sriov-dkms"
		;;

	6.18.18.c877-trim)
		echo "debug 6.18.18.c877-trim"
		copy_kernel_module "${PACKAGE_BASE}/app/i915-sriov-dkms_6.18.18.c877-trim-amd64" "/lib/modules/6.18.18.c877-trim/updates/dkms/i915-sriov-dkms"
		;;

	*) ;;
	esac

	cp -nv ${PACKAGE_BASE}/app/firmware/* /usr/lib/firmware/i915/
	echo "firmware list"
	ls -al /usr/lib/firmware/i915/
	md5sum /usr/lib/firmware/i915/*

	echo "depmod："
	depmod
	if grub-mkconfig -o /dev/null;then
		echo "update-initramfs -u"
		update-initramfs -u
	else
	  echo "grub file with error"
	fi

	for mod in i915 kvmgt; do
	  echo "modprobe -D $mod"
	  modprobe -D "$mod"
	done

	echo "try remove driver"
	if modprobe -r -v i915;then
	  echo "try load driver"
		modprobe -v i915
		systemctl restart mediasrv.service resmon_service.service || echo "systemctl restart failed"
	fi

	echo "find i915 file"
	find /lib/modules/ -name "*915*"
	echo "/proc/cmdline"
	cat /proc/cmdline

	echo "dmesg $(uptime)"
	dmesg | grep i915 | grep -v '0x550b failed' | grep -v 'state (-EPROTO)'
	print_pci
	;;
stop) ;;

status)
	if [ ! -d "/lib/modules/$(uname -r)/updates/dkms/i915-sriov-dkms" ]; then
		echo -e "$(date +'%Y/%m/%d %H:%M:%S')\t" $0 $*
		echo "dmesg $(uptime)"
		dmesg | grep i915 | grep -v '0x550b failed' | grep -v 'state (-EPROTO)'
		exit 3
	fi
	;;
*)
	exit 1
	;;
esac
